# 留空时，前端会自动使用当前页面主机的 8000 端口
NEXT_PUBLIC_API_BASE_URL=
NEXT_TELEMETRY_DISABLED=1

# 歌词库服务端代理；这些变量不会发送到浏览器
LYRICS_API_BASE_URL=http://127.0.0.1:8000
# 留空时自动读取 ../backend/.env 中的 APP_ACCESS_TOKEN
LYRICS_LIBRARY_TOKEN=

# Cloudflare Worker 歌词搜索代理；留空时直接连接 LRCLIB
NEXT_PUBLIC_LYRICS_PROXY_URL=

# 配置同一代理地址后会启用 /translate 在线翻译；失败时自动回退离线词典
# 公共 GitHub Release 仓库，格式为 owner/repo；也可在应用设置中填写
NEXT_PUBLIC_UPDATE_REPO=
