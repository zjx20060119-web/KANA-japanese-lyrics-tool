{
  "name": "frontend",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/vendor-kuromoji.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/vendor-kuromoji.mjs",
    "build": "next build",
    "build:web": "node scripts/build-web.mjs",
    "build:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "cap:sync": "npm run build:web && npx cap sync android",
    "cap:android": "npx cap open android",
    "icons:android": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-android-icons.ps1",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "dexie": "^4.4.7",
    "html-to-image": "^1.11.13",
    "kuromoji": "^0.1.2",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@tailwindcss/turbopack": "^4",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
